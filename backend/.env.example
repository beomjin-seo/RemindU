# Anthropic extraction (text-only when the client sends ocr_text; image
# fallback only for legacy clients that send no OCR)
ANTHROPIC_API_KEY=
EXTRACTOR_MODEL=claude-opus-5
# PRIVACY: screenshot pixels are sent to the model only when true.
ALLOW_IMAGE_EXTRACTION=false

# 11st OpenAPI ProductSearch (primary shopping search; the Naver Shopping
# search API was terminated 2026-07-31)
ELEVENST_API_KEY=

# Google Custom Search, restricted to the trusted-domain allowlist (optional)
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Naver Open API (Local search for places; legacy keys valid until 2027-06-30)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# APNs token-based auth (optional; pushes are logged as "unconfigured" when unset)
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_AUTH_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
# APNS_BUNDLE_ID=com.captureinbox.app
# APNS_USE_SANDBOX=true
# "찾았어요" push right after a capture resolves (validation-cohort default)
# PUSH_ON_RESOLVED=true

# Storage (defaults: sqlite + files under backend/data/)
# DATABASE_URL=sqlite:///./data/capture_inbox.db
# DATA_DIR=./data/captures
